  amountCents Int
  taxCents Int
  @@unique([creditNoteId,invoiceLineId])
  @@index([invoiceLineId])
}

// VEN-03 : retour physique traçable, avant décision financière distincte.
model CustomerReturn {
  id Int @id @default(autoincrement())
  ref String @unique
  deliveryLineId Int
  deliveryLine SalesDeliveryLine @relation(fields:[deliveryLineId],references:[id],onDelete:Restrict)
  qty Float
  unit String
  pieceIdsJson String @default("[]")
  reason String
  status String @default("requested") // requested | quarantine | accepted | rejected
  requestKey String? @unique
  createdBy String
  createdAt DateTime @default(now())
  receivedBy String?
  receivedAt DateTime?
  qualityBy String?
  qualityAt DateTime?
  qualityReason String?
  finishedStockLotId Int? @unique
  finishedStockLot FinishedStockLot? @relation(fields:[finishedStockLotId],references:[id],onDelete:Restrict)
  @@index([deliveryLineId,status])
}

// VEN-01 : lots distincts de PRODUITS FINIS, jamais confondus avec les lots matière.
// Entrées physiques sous double contrôle magasin/qualité ; sorties par BL uniquement.
model FinishedStockLot {
  id Int @id @default(autoincrement())
  productId Int
  product Product @relation(fields:[productId],references:[id],onDelete:Restrict)
  lotCode String
  status String @default("quarantine") // quarantine | available | rejected | exhausted
  qty Int @default(0) // unités indivisibles, seulement pour produits finis vendus à l'unité
  sourceRef String
  workOrderId Int? // lien optionnel a un OF de CMD termine, pas un OF de reconstitution
  workOrder WorkOrder? @relation(fields:[workOrderId],references:[id],onDelete:Restrict)
  receivedBy String
  qualityBy String?
  receivedAt DateTime @default(now())
  expiresAt DateTime?
  movements FinishedStockMovement[]
  allocations FinishedStockAllocation[]
  reservations FinishedStockReservation[]
  customerReturn CustomerReturn?
  @@unique([productId,lotCode])
  @@index([workOrderId])
  @@index([productId,status])
}
// Réservation ferme sur lot fini, sans débit physique et sans fausse fabrication.
// Posée lors de la préparation d'un OF stock ; consommée au BL ou libérée si suspendue.
model FinishedStockReservation {
  id Int @id @default(autoincrement())
  orderLineId Int
  orderLine OrderLine @relation(fields:[orderLineId],references:[id],onDelete:Restrict)
  lotId Int
  lot FinishedStockLot @relation(fields:[lotId],references:[id],onDelete:Restrict)
  qty Int // matelas finis à l'unité
  createdBy String
  // Sémantique d'engagement : createdAt (jamais modifié après création).
  createdAt DateTime @default(now())
  // P6 (2026-11-11), chantier 2 §3.3 : dernière modification (consommation
  // partielle). NULL pour les lignes historiques jusqu'à leur prochaine écriture.
  updatedAt DateTime? @updatedAt
  @@unique([orderLineId,lotId])
  @@index([lotId])
}
model FinishedStockMovement {
  id Int @id @default(autoincrement())
  ref String @unique
  lotId Int
  lot FinishedStockLot @relation(fields:[lotId],references:[id],onDelete:Restrict)
  type String // received_quarantine | released | rejected | out
  qty Int // signé uniquement pour out ; autres types n'affectent pas qty physique
  document String
  actor String
  createdAt DateTime @default(now())
  @@index([lotId,createdAt])
}
model FinishedStockAllocation {
  id Int @id @default(autoincrement())
  deliveryLineId Int
  deliveryLine SalesDeliveryLine @relation(fields:[deliveryLineId],references:[id],onDelete:Restrict)
  lotId Int
  lot FinishedStockLot @relation(fields:[lotId],references:[id],onDelete:Restrict)
  qty Int
  createdAt DateTime @default(now())
  @@unique([deliveryLineId,lotId])
  @@index([lotId])
}

// GoCmd V18.9.13 : comptes individuels persistants et audit des habilitations.
// Installation NON DESTRUCTIVE uniquement via scripts/bootstrap-admin.cjs ;
// ne pas utiliser prisma db push pour déployer sur une base SODEPI existante.
// Contrats SQL/Prisma synchronisés avec src/lib/user-directory.cjs.
model GoCmdUser {
  id                   Int    @id @default(autoincrement())
  username             String @unique
  salt                 String
  password_hash        String
  roles_json           String
  permissions_json     String @default("{}")
  active               Int    @default(1)
  is_root              Int    @default(0)
  must_change_password Int    @default(1)
  created_at           String
  updated_at           String
}
model GoCmdAccessAudit {
  id           Int    @id @default(autoincrement())
  at           String
  actor        String
  action       String
  target       String
  details_json String

  @@index([at])
}
// R13.3 (CORR-01) : sessions révocables écrites par le client Prisma en mode
// serveur (src/lib/identity-writes.ts). Simple mapping de la table installée
// par src/lib/user-directory.cjs (ensureSchema / upgrade-admin-session.cjs) :
// AUCUNE migration du disque — la table existe déjà sur toutes les bases.
model GoCmdSession {
  token_hash String @id
  username   String
  expires_at Int
  created_at String

  @@index([expires_at], map: "GoCmdSession_expires_idx")
}
