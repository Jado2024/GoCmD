generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Matières premières (mousses, tissus, mercerie, emballage…)
// ─────────────────────────────────────────────────────────────
model Material {
  id        Int      @id @default(autoincrement())
  ref       String   @unique // ex. "Mousse-D33", "TISSU-Standard-…"
  name      String // libellé lisible
  category  String // Mousse | Tissu | Mercerie | Emballage & consommables
  unit      String // m³ | ml | kg | pcs
  unitPrice Float // MAD par unité
  stockQty  Float   @default(0)
  minStock  Float   @default(0)
  targetStock Float? // null = minStock, seuil de declenchement distinct de la cible
  location  String?
  supplier  String?
  foamNature String? // PURE | AGGLO (matières mousse seulement)
  foamFormat String? // ROULEAU | PLAQUE | BLOC (mousse pure) ; PLAQUE | BLOC (agglomeree)
  foamGrade String? // qualité/type interne fictif en simulation
  foamDensity Float? // kg/m³ (matières mousse seulement)
  foamColor String? // couleur codifiee BLN/BLE/... pour mousse
  foamFirmness String? // SOU | MOY | FER | TFR, facultatif
  foamResilience Float? // pourcentage, facultatif
  foamSupplierGrade String? // grade technique, pas identifiant fournisseur
  foamLengthCm Float? // longueur de reference (rouleau: si fixe)
  foamWidthCm Float? // largeur
  foamHeightCm Float? // hauteur bloc
  foamThicknessCm Float? // epaisseur plaque/rouleau
  description String? // description detaillee, proposee et editable
  foamIdentityKey String? @unique // empreinte canonique des variantes, null pour anciennes fiches
  canonicalIdentity String? @unique // V2, toutes les familles, empreinte JSON typée
  technicalAttributesJson String? // V2, attributs distinctifs figés et normalisés
  // P5.15.3 : un même article matière peut être acheté, utilisé et revendu.
  isPurchasable Boolean @default(true)
  isManufactured Boolean @default(false)
  isSellable Boolean @default(false)
  isInternalUse Boolean @default(true)
  salesUnit String? // null => unite de stock
  unitsPerSale Float @default(1) // nombre d'unites de stock / unite de vente
  salesUnitPrice Float @default(0) // prix indicatif MAD / unite de vente, distinct cout d'achat
  pendingSalesUnitPrice Float?
  salesPriceProposedBy String?
  salesPriceProposalReason String?
  salesPriceProposedAt DateTime?
  salesPriceProposalRevision Int @default(0)
  tradeProduct Product?

  movements     Movement[]
  purchaseLines PurchaseRequestLine[]
  productionRequests ProductionReplenishmentRequest[]
  supplierLinks SupplierMaterial[]
  supplierOrderLines SupplierOrderLine[]
  stockLots StockLot[]
  qualityChecks QualityInspection[]
  averageCost Decimal?
  rfqs SupplierRFQ[]
  priceAgreements SupplierPriceAgreement[]
}

// ─────────────────────────────────────────────────────────────
// Produits (finis / semi-finis) — BANQUETTE | GAUFRETTE | SALON | MATELAS | PLAQUE_MOUSSE
// Pas de nomenclature (BOM) pour le moment.
// Vente au ml (banquettes, gaufrettes, salons) ; matelas à l'unité.
// Le prix est SAISI à la commande (ajustable selon dimensions) ;
// unitPrice n'est qu'un prix indicatif par défaut.
// ─────────────────────────────────────────────────────────────
model Product {
  id        Int      @id @default(autoincrement())
  sku       String   @unique
  canonicalIdentity String? @unique // V2, identité technique des PF fixes
  technicalAttributesJson String?
  isOrderScoped Boolean @default(false) // fiche technique interne propre à une ligne GEN, invisible au catalogue
  revisionOfId Int? // Identifiant de la version antérieure (historique conservé)
  revisionNumber Int @default(1)
  revisionRequestedBy String?
  revisionApprovedBy String?
  name      String // "BANQUETTE ARVENA - 100×70×27"
  family    String
  model     String
  subCategory String? // Adulte | Enfant | Bébé | Hôtellerie | Sur mesure (matelas)
  commercialAbbreviation String? // Code court commercial propose, modifiable, jamais suffixe C/S impose
  commercialBrand String? // Marque sous laquelle le produit est vendu
  actualManufacturer String? // Fabricant reel, distinct de la marque commerciale
  descriptionOverride String? // Designation editee, independante du SKU et de la fiche technique
  legacySku String?   // Conservé au schéma pour compatibilité (vide dans catalogue renommé)
  legacyName String?  // Conservé au schéma pour compatibilité (vide)
  legacyModel String? // Conservé au schéma pour compatibilité (vide)
  variant   String   @default("STD") // STD | L | U
  length    Int
  width     Int
  height    Int
  unit      String   @default("u") // unité de vente : ml | u
  unitPrice Float    @default(0) // prix de vente indicatif (saisi)
  minStock Float @default(0) // seuil d’alerte pour reconstitution du stock
  targetStock Float? // objectif de stock ; null = seuil minimum
  pendingCatalogUnitPrice Float? // proposition, jamais appliquee sans directeur
  catalogPriceProposedBy String?
  catalogPriceProposalReason String?
  catalogPriceProposedAt DateTime?
  catalogPriceProposalRevision Int @default(0)
  // Classification commerciale et technique GoCmd V16 (métier SODEPI, données DEMO)
  coreType String? // SANS_RESSORTS | BONNELL | ENSACHES — matelas et banquettes
  foamComposition String? // PURE | MELANGE | AGGLO — composition de la partie mousse
  mattressFinish String? // SANS | TOPPER | ALESE — mutuellement exclusifs
  upholstery String? // NUE | TISSU — seulement les banquettes
  foamNature String? // PURE | AGGLO — plaques de mousse
  foamGrade String? // qualité/type, nomenclature configurable
  foamDensity Float? // densité kg/m³ si une seule mousse
  foamLayers String? // JSON de couches (mélanges), densités et épaisseurs distinctes
  taxonomyVersion Int @default(1)
  createdAt DateTime @default(now())
  status String @default("active") // active | pending_validation | rejected
  similarProductId Int?
  similarProductSku String?
  specialNotes String?
  // Autorisation tarifaire indépendante de la validation ordinaire de commande.
  // not_required (catalogue ordinaire) | pending | approved | rejected.
  specialPriceStatus String @default("not_required")
  specialApprovedUnitPrice Float?
  specialPriceProposedBy String?
  specialPriceApprovedBy String?
  specialPriceApprovedAt DateTime?
  specialPriceDecisionReason String?
  specialPriceRevision Int @default(0)
  // Article commercial de négoce : une seule source de stock = Material.
  materialId Int? @unique
  material Material? @relation(fields: [materialId], references: [id])
  unitsPerSale Float @default(1)

  orderLines OrderLine[]
  finishedStockLots FinishedStockLot[]
  productionRequests ProductionReplenishmentRequest[]

  @@index([family, model, variant])
  @@index([name])
  @@index([subCategory])
  @@index([family, coreType, foamComposition])
  @@index([family, foamNature, foamDensity])
  @@index([legacySku])
}


// Proposition de reconstitution du stock, jamais un OF de commande client.
// Validation explicite, livraison en stock distincte et controles de doublons.
model ProductionReplenishmentRequest {
  id Int @id @default(autoincrement())
  ref String @unique
  productId Int?
  product Product? @relation(fields:[productId],references:[id],onDelete:Restrict)
  materialId Int?
  material Material? @relation(fields:[materialId],references:[id],onDelete:Restrict)
  qty Float
  unit String
  status String @default("proposed") // proposed | approved | rejected | cancelled | completed
  reason String
  createdBy String
  createdAt DateTime @default(now())
  decidedBy String?
  decidedAt DateTime?
  decisionReason String?
  stockOrder ProductionStockOrder?
  @@index([productId,status])
  @@index([materialId,status])
}

// P5.15.26 : OF de fabrication POUR STOCK. Indépendant de l'OF lié à une CMD.
// Une DPR approuvée crée exactement un ordre, sans mouvement physique automatique.
model ProductionStockOrder {
  id Int @id @default(autoincrement())
  ref String @unique
  requestId Int @unique
  request ProductionReplenishmentRequest @relation(fields:[requestId],references:[id],onDelete:Restrict)
  status String @default("approved") // approved | planned | in_progress | completed | closed | cancelled
  createdBy String
  createdAt DateTime @default(now())
  plannedStartAt DateTime?
  dueAt DateTime?
  plannedBy String?
  startedBy String?
  startedAt DateTime?
  completedBy String?
  completedAt DateTime?
  closedBy String?
  closedAt DateTime?
  statusReason String?
  materialReceipts ProductionMaterialReceipt[]
  approvedMaterialCost ProductionMaterialCostApproval?
  @@index([status,createdAt])
}

// Receptions physiques MTS de matieres fabriquees, avant libération qualité.
// qty et liens de provenance sont immuables ; seule la décision qualité évolue.
model ProductionMaterialReceipt {
  id Int @id @default(autoincrement())
  stockOrderId Int
  stockOrder ProductionStockOrder @relation(fields:[stockOrderId],references:[id],onDelete:Restrict)
  stockLotId Int @unique
  stockLot StockLot @relation(fields:[stockLotId],references:[id],onDelete:Restrict)
  qty Float
  status String @default("quarantine") // quarantine | released | rejected
  receivedBy String
  receivedAt DateTime @default(now())
  decidedBy String?
  decidedAt DateTime?
  reason String?
  @@index([stockOrderId,status])
}

// Production supervisor authorization for each rejected source, used atomically.
// This replaces no historic receipt and cannot authorize more than rejected qty.
model ProductionReworkApproval {
  id Int @id @default(autoincrement())
  ref String @unique
  sourceKind String // material_receipt | finished_lot
  sourceId Int
  productionRef String
  qty Float
  usedQty Float @default(0)
  unit String
  approvedBy String
  approvedAt DateTime @default(now())
  reason String
  @@unique([sourceKind,sourceId])
}

// A cost recorded by a DIFFERENT finance actor: standard provisional valuation,
// not a fabricated actual BOM/manufacturing cost. Once issued it is immutable.
model ProductionMaterialCostApproval {
  id Int @id @default(autoincrement())
  stockOrderId Int @unique
  stockOrder ProductionStockOrder @relation(fields:[stockOrderId], references:[id], onDelete:Restrict)
  unitCost Decimal
  currency String @default("MAD")
  approvedBy String
  approvedAt DateTime @default(now())
  reason String
}

// ─────────────────────────────────────────────────────────────
// Clients
// ─────────────────────────────────────────────────────────────
model Client {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  city   String
  phone  String?
  orders Order[]
  salesQuotes SalesQuote[]
  salesInvoices SalesInvoice[]
}

// ─────────────────────────────────────────────────────────────
// Commandes clients
// ─────────────────────────────────────────────────────────────
model Order {
  id        Int      @id @default(autoincrement())
  ref       String   @unique
  clientId  Int
  client    Client   @relation(fields: [clientId], references: [id])
  status    String   @default("new") // new | production | ready | shipped
  priority  String   @default("normale") // normale | haute
  dueDate   DateTime?
  note      String?
  customerOrderNo String? // numéro de commande externe (photo : Cde.)
  customerOrderNoNormalized String? // unicité par client, migration offline P5
  reviewComment String?
  reviewedBy String?
  reviewedAt DateTime?
  // P5.15.21 (SEP-001) : créateur de la commande, base de la garde quatre-yeux
  // (le créateur ne peut pas valider sa propre commande). Null pour l'historique
  // pré-P5.15.21 : ces commandes ne déclenchent jamais la garde.
  createdBy String?
  createdAt DateTime @default(now())
  // Clé optionnelle par intention de saisie : hash utilisateur+clé client.
  // NULL pour les commandes historiques et clients API sans clé explicite.
  createRequestKey String? @unique
  createRequestDigest String?
  lines     OrderLine[]
  workOrders WorkOrder[]
  quoteId Int? @unique
  quote SalesQuote? @relation(fields:[quoteId],references:[id])
  salesDeliveries SalesDelivery[]
  salesInvoices SalesInvoice[]
  fulfillmentStatus String @default("open") // open | on_hold | closed (distinct atelier)
  fulfillmentReason String?
  fulfillmentActor String?
  fulfillmentChangedAt DateTime?

  @@index([status])
  @@index([dueDate])
  @@unique([clientId, customerOrderNoNormalized])
  @@index([clientId, dueDate])
  // R11 PERF-02: ORDER BY createdAt DESC,id DESC avec LIMIT pour le tableau.
  @@index([createdAt(sort: Desc), id(sort: Desc)], map: "Order_createdAt_id_idx")
}

model OrderLine {
  id        Int     @id @default(autoincrement())
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  kind String @default("CATALOG") // CATALOG | GENERIC
  genericTemplate String? // GEN-MAT | GEN-MOU | GEN-SAL | GEN-DIV
  technicalSnapshotJson String? // configuration contractuelle immuable dès commande
  technicalSnapshotHash String? // SHA-256 du snapshot de configuration
  qty       Float // quantité dans l'unité de vente (décimal autorisé, ex. 6,5 ml)
  unit      String  @default("u") // unité figée à la saisie : ml | u
  unitPrice Float // Prix contractuel figé par ligne en MAD
  catalogUnitPriceSnapshot Float? // Tarification de référence au moment de la saisie
  priceApprovalStatus String @default("not_required") // not_required | pending | approved
  priceApprovedBy String?
  priceApprovedAt DateTime?
  priceApprovalReason String?
  technicalInstructions String? // Consignes atelier contractuelles de cette commande
  customDimensionsJson String? // Dimensions dérogatoires figées (cm)
  technicalReviewRequired Boolean @default(false)
  stockUnit String? // photographie de l'unite de stock pour la revente
  stockUnitsPerSale Float @default(1) // conversion figée lors de la commande
  modelRef  String? // ex. F111XY, référence commerciale
  configRef String? // ex. 10199625 CG, référence configuration
  // Désignation contractuelle figée à la confirmation de commande (VEN-02).
  productNameSnapshot String?
  productSkuSnapshot String?
  pieces    OrderPiece[]
  workOrder WorkOrder?
  deliveryLines SalesDeliveryLine[]
  reservations SalesStockReservation[]
  finishedReservations FinishedStockReservation[]
  @@index([orderId]) // audit 2026-11-10 : FK non indexée par SQLite
  @@index([productId]) // audit 2026-11-10 : FK non indexée par SQLite
}

// Une pièce physique fabriquée = une étiquette, même si plusieurs pièces
// appartiennent à la même ligne commerciale / au même salon.
model OrderPiece {
  id          Int      @id @default(autoincrement())
  code        String   @unique // identifiant permanent de traçabilité
  orderLineId Int
  orderLine   OrderLine @relation(fields: [orderLineId], references: [id], onDelete: Cascade)
  salonNo     Int      @default(1) // salon N sur M lorsqu'on en commande plusieurs
  elementNo   Int      @default(1) // position unique dans la commande
  partRef     String?  // identifiant métier libre: L01, L02 (doublons autorisés)
  linearMeters Float?  // longueur de facturation validée de cette pièce (ml)
  gabaritCode String?  // STD, 06, 11...51 (52 exclu)
  billingMode String   @default("manual") // manual, reserved for verified formula
  sequence    Int      // ordre physique de l'étiquette sur la ligne
  label       String   // nom de la banquette / pièce
  shape       String   @default("rectangle")
  lengthCm    Float
  widthCm     Float
  heightCm    Float
  dimensionsExtra String? // JSON mesures supplémentaires selon le gabarit
  note        String?
  status      String   @default("pending")
  createdAt   DateTime @default(now())

  @@index([orderLineId])
  @@index([status])
}


// OF simplifiés GoCmd : un OF tracé par ligne commerciale, y compris négoce.
// Aucun mouvement de stock à la création ; aucun procédé GoProd exécuté ici.
model WorkOrder {
  id Int @id @default(autoincrement())
  ref String @unique
  orderId Int
  order Order @relation(fields:[orderId], references:[id], onDelete:Restrict)
  orderLineId Int @unique
  orderLine OrderLine @relation(fields:[orderLineId], references:[id], onDelete:Restrict)
  status String @default("draft") // draft | approved | in_progress | completed | cancelled
  snapshotJson String // fiche + pièces figées à la création
  totalPieces Int // Nombre d’étiquettes : pièces physiques ou 1 étiquette de préparation
  createdBy String
  createdAt DateTime @default(now())
  approvedBy String?
  approvedAt DateTime?
  startedBy String?
  startedAt DateTime?
  completedBy String?
  completedAt DateTime?
  preparationKind String? // stock | manufacturing | legacy_stock, sans impact sur la CMD
  finishedStockReceipts FinishedStockLot[]
  @@index([orderId,status])
  @@index([status,createdAt])
}

// ─────────────────────────────────────────────────────────────
// Mouvements de stock (matières premières)
// type : in (réception) | out (sortie) | production (consommation
// atelier saisie manuellement) | adjust (régularisation)
// ─────────────────────────────────────────────────────────────
model Movement {
  id         Int       @id @default(autoincrement())
  ref        String    @unique
  type       String // in | out | production | adjust
  materialId Int?
  // Audit 10/11/2026 (DB-HIST-02) : Restrict explicite — la suppression d'une
  // matière ne doit jamais détacher l'historique des mouvements (le DDL réel
  // portait ON DELETE SET NULL ; complété par le trigger SQL
  // gocmd_no_hard_delete_material installé par upgrade_material_delete_guard_20261110.py).
  material   Material? @relation(fields: [materialId], references: [id], onDelete: Restrict)
  qty        Float
  unit       String?
  reason     String
  document   String?
  operator   String
  createdAt  DateTime  @default(now())

  goodsReceiptLine GoodsReceiptLine?
  stockLotId Int?
  stockLot StockLot? @relation(fields: [stockLotId], references: [id])
  salesAllocation SalesStockAllocation?
  signedQty Float? // quantité signée : positive entrée, négative sortie
  isArchived Boolean @default(false) // ancien historique de démonstration, jamais dans les soldes
  archivedAt DateTime?
  archiveReason String?
  isOpeningBalance Boolean @default(false) // reprise démo = écriture d'ouverture, pas une livraison
  @@index([isArchived, createdAt])
  @@index([isOpeningBalance])
  @@index([createdAt])
  @@index([materialId])
  @@index([stockLotId]) // audit 2026-11-10 : FK non indexée par SQLite
}

// ─────────────────────────────────────────────────────────────
// Demandes d'achat (matières premières)
// Workflow : pending → approved → ordered → partial → received ; closed (solde annulé)
// ─────────────────────────────────────────────────────────────
model PurchaseRequest {
  id           Int       @id @default(autoincrement())
  ref          String    @unique
  status       String    @default("pending") // pending | approved | partially_approved | rejected | ordered | partial | received | closed | cancelled
  supplier     String?
  expectedDate DateTime?
  note         String?
  createdAt    DateTime  @default(now())
  lines        PurchaseRequestLine[]
  receipts     PurchaseReceipt[]
  closedReason String?
  closedBy     String?
  closedAt     DateTime?
  createdBy    String?
  approvedBy   String?
  approvedAt   DateTime?

  @@index([status])
  @@index([status,createdAt,id])
  @@index([createdAt,id])
}

model PurchaseRequestLine {
  id         Int          @id @default(autoincrement())
  requestId  Int
  request    PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  materialId Int
  material   Material     @relation(fields: [materialId], references: [id])
  qty        Float // quantité initialement demandée, jamais modifiée par la validation
  approvedQty Float @default(0) // autorisé après décision; 0 pour ligne en attente/refusée
  approvalDecision String @default("pending") // pending | approved | reduced | rejected
  approvalReason String?
  decisionBy String?
  decisionAt DateTime?
  unitPrice  Float?
  receivedQty Float  @default(0)
  receiptLines PurchaseReceiptLine[]
  supplierOrderLines SupplierOrderLine[]
  @@index([requestId]) // audit 2026-11-10 : FK non indexée par SQLite
}

// Pièce justificative de réception ; un BL n'est validé qu'une fois par DA.
model PurchaseReceipt {
  id           Int      @id @default(autoincrement())
  requestId    Int
  request      PurchaseRequest @relation(fields: [requestId], references: [id])
  deliveryRef  String
  operator     String
  note         String?
  createdAt    DateTime @default(now())
  lines        PurchaseReceiptLine[]

  @@unique([requestId, deliveryRef])
  @@index([createdAt])
}

model PurchaseReceiptLine {
  id            Int @id @default(autoincrement())
  receiptId     Int
  receipt       PurchaseReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  requestLineId Int
  requestLine   PurchaseRequestLine @relation(fields: [requestLineId], references: [id])
  acceptedQty   Float
  rejectedQty   Float @default(0)
  lot           String?
  note          String?

  @@unique([receiptId, requestLineId])
  @@index([requestLineId]) // audit 2026-11-10 : FK non indexée par SQLite
}



// APPROVISIONNEMENTS V2 : DA (besoin) -> BC (fournisseur) -> BR (réception) -> stock.
// Les anciennes tables PurchaseReceipt restent en lecture pour l'historique.
model Supplier {
  id Int @id @default(autoincrement())
  code String @unique
  name String @unique
  phone String?
  email String?
  address String?
  city String?
  country String?
  ice String? // Identifiant commun de l'entreprise (Maroc)
  taxId String? // Identifiant fiscal (Maroc)
  tradeRegister String? // Registre de commerce
  paymentTerms String? // Conditions de paiement indicatives
  active Boolean @default(true)
  createdAt DateTime @default(now())
  materials SupplierMaterial[]
  orders SupplierOrder[]
  deliveryNotes SupplierDeliveryNote[]
  returns SupplierReturn[]
  invoices SupplierInvoice[]
  qualifications SupplierQualification[]
  quoteOffers SupplierQuoteOffer[]
  consultationRecipients SupplierConsultationRecipient[]
  priceAgreements SupplierPriceAgreement[]
  creditNotes SupplierCreditNote[]
  disputes SupplierDispute[]
  refunds SupplierRefund[] // V18.9.2 (contre-audit F02)
}

model SupplierMaterial {
  id Int @id @default(autoincrement())
  supplierId Int
  supplier Supplier @relation(fields: [supplierId], references: [id])
  materialId Int
  material Material @relation(fields: [materialId], references: [id])
  supplierSku String?
  supplierLookupKey String? @unique // clé normalisée fournisseur + référence, hors exceptions approuvées
  supplierSkuExceptionApprovedBy String?
  supplierSkuExceptionReason String?
  unitPrice Float?
  leadTimeDays Int?
  preferred Boolean @default(false)
  purchaseUnit String?
  unitsPerPurchase Float @default(1) // quantité unité stock par 1 unité achetée
  @@unique([supplierId, materialId])
  @@index([materialId])
}

model SupplierOrder {
  id Int @id @default(autoincrement())
  ref String @unique
  supplierId Int
  supplier Supplier @relation(fields: [supplierId], references: [id])
  status String @default("draft") // draft | confirmed | partial | received | closed
  expectedDate DateTime?
  note String?
  createdAt DateTime @default(now())
  closedAt DateTime?
  closedReason String?
  createdBy String?
  approvedBy String?
  lines SupplierOrderLine[]
  receipts GoodsReceipt[]
  revisions SupplierOrderRevision[]
  deliveries SupplierDeliverySchedule[]
  @@index([supplierId, status])
}

model SupplierOrderLine {
  id Int @id @default(autoincrement())
  orderId Int
  order SupplierOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  materialId Int
  material Material @relation(fields: [materialId], references: [id])
  requestLineId Int?
  requestLine PurchaseRequestLine? @relation(fields: [requestLineId], references: [id])
  qty Float // stock units
  receivedQty Float @default(0) // accepted quantities only
  unitPrice Float // stock unit cost, not purchase-unit cost
  purchaseQty Float?
  purchaseUnit String?
  conversionFactor Float @default(1)
  priceSourceType String? // QUOTE | CONTRACT ; null pour historique P5.10
  priceSourceId Int? // Identifiant de l’offre ou accord approuvé
  priceSourceRef String? // Identifiant lisible, photographie au moment du BC
  receiptLines GoodsReceiptLine[]
  @@index([requestLineId])
  @@index([materialId])
  @@index([orderId]) // audit 2026-11-10 : FK non indexée par SQLite
}

model GoodsReceipt {
  id Int @id @default(autoincrement())
  ref String @unique
  supplierOrderId Int
  supplierOrder SupplierOrder @relation(fields: [supplierOrderId], references: [id])
  deliveryRef String
  operator String
  note String?
  deliveryNoteId Int?
  deliveryNote SupplierDeliveryNote? @relation(fields: [deliveryNoteId], references: [id])
  createdAt DateTime @default(now())
  lines GoodsReceiptLine[]
  @@unique([supplierOrderId, deliveryRef])
  @@index([createdAt])
}

model GoodsReceiptLine {
  id Int @id @default(autoincrement())
  goodsReceiptId Int
  goodsReceipt GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  supplierOrderLineId Int
  supplierOrderLine SupplierOrderLine @relation(fields: [supplierOrderLineId], references: [id])
  acceptedQty Float
  rejectedQty Float @default(0)
  returnedQty Float @default(0) // formerly accepted but returned to vendor (distinct from initial refusal)
  lot String?
  movementId Int? @unique
