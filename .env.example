# Copiez ces valeurs dans .env et définissez VOS propres secrets.
DATABASE_URL="file:../db/custom.db"
# Mode démo historique seulement : mot de passe partagé (>=16 caractères).
# Après initialisation des comptes SQLite, ce compte partagé est désactivé.
GOCMD_ACCESS_PASSWORD=""
GOCMD_REQUIRE_SQLITE_USERS="1"
# Les validations techniques utilisent le compte nominatif : aucune clé commune.
# Les visas tarifaires sensibles demandent ponctuellement le mot de passe du directeur.

# Option de compatibilité AVANT la migration : comptes au format JSON.
# Une fois les comptes SQLite initialisés, les comptes JSON sont ignorés.
# Ex: {"acheteur":{"salt":"hex","hash":"hex","roles":["buyer"]}}
GOCMD_USERS_JSON=""
# Prix spéciaux : créer un compte distinct avec le rôle EXPLICITE director.
# Exemple : node scripts/create-user.cjs direction director
# Ni approver ni admin seuls ne peuvent approuver ce prix.
GOCMD_REQUIRE_RBAC="1"
# V18.9.9 : le compte de démonstration partagé est STRICTEMENT en lecture
# seule et sans aucun rôle — l'ancien drapeau GOCMD_ALLOW_LEGACY_WRITES a été
# supprimé du logiciel ; plus aucun réglage ne peut élever ses privilèges.

# HTTP CSRF: URL publique exacte du navigateur en production, surtout derrière reverse proxy.
# GOCMD_PUBLIC_ORIGIN="https://gocmd.example.ma"
# Si et seulement si le reverse proxy filtre les accès directs et réécrit les X-Forwarded-* :
GOCMD_TRUST_PROXY="0"
# IMPORTANT: HTTPS et limitation de requêtes par IP à configurer sur le reverse proxy.

# V18.9.3 — démarrage fiable : préférer le lanceur contrôlé
# GOCMD_DB_FILE="/chemin/absolu/vers/base-reelle.db"
# npm run start:checked
# Ce lanceur ne choisit PAS automatiquement la base de démonstration.
# Pour recette UNIQUEMENT: GOCMD_DB_FILE=db/custom.db npm run start:checked

# V18.9.13 : après bootstrap, forcer les comptes SQLite et INTERDIRE le repli sur les anciens secrets.
# Ajouter à .env après bootstrap : GOCMD_REQUIRE_SQLITE_USERS="1"

# Règle SODEPI 08/11/2026 — à remplacer après validation du comptable.
# DEMONSTRATION UNIQUEMENT : 0 et 20 % ne constituent pas un barème fiscal officiel.
# Si variable absente/invalide, GoCmd refuse toute nouvelle facture client.
GOCMD_SALES_TAX_RATES_BPS=""
# Après validation comptable seulement, renseigner p. ex. des taux approuvés
# GOCMD_SALES_TAX_RATES_BPS="..."

# Arbitrage SODEPI 08/11/2026 — aucune durée imposée sans validation métier.
# Durée (heures) et préavis (heures) à fixer AVANT programmation de la tâche.
# GOCMD_RESERVATION_TTL_HOURS=72  # Exemple DEMO seulement; ne pas imposer sans validation SODEPI
# GOCMD_RESERVATION_WARNING_HOURS=24  # Exemple DEMO seulement; ne pas imposer sans validation SODEPI
GOCMD_REQUIRE_OF_FOR_PRODUCTION=1 # Contrôle strict des OF en recette et production

# Démarrage protégé : npm run start exige GOCMD_DB_FILE (chemin explicite).
# La base db/custom.db livrée est réservée à la DEMO : refus sans dérogation explicite.
# Pour une démonstration LOCALE seulement : GOCMD_ALLOW_DEMO_DB=1 et HOSTNAME=127.0.0.1.
# Ne jamais utiliser cette dérogation pour la production SODEPI.
# GOCMD_ALLOW_DEMO_DB=0

# Paramétrages comptables de production — à valider par SODEPI.
# Sans barème TVA achats / plafond fret, une facture fournisseur est BLOQUÉE
# en mode production (la saisie reste possible pour traitement d'un litige).
# Taux en points de base (100 = 1 %), EXEMPLE DEMO : "0,2000".
GOCMD_PURCHASE_TAX_RATES_BPS=""
# Plafond du fret, en proportion du HT+TVA lignes (bps ; 10000 = 100 %).
GOCMD_PURCHASE_FREIGHT_MAX_BPS=""
# Par défaut l'avoir client monétaire sans lignes est interdit en production.
# Ne mettre 1 qu'après procédure comptable documentée et validation SODEPI.
GOCMD_ALLOW_FREE_CLIENT_CREDITS="0"
# Pour limiter par IP + compte, activer uniquement derrière un reverse proxy
# sûr qui réécrit les entêtes X-Forwarded-For (et interdit l'accès direct).
# GOCMD_TRUST_PROXY="1"

# P5.15.28 P1 — les offres PDF sont hors du répertoire public ; inclure dans
# les sauvegardes complètes. Chemin absolu recommandé.
# GOCMD_DOCUMENTS_DIR="/disque-prive/gocmd-private-documents"
# En mode exploitation, journal SQLite DELETE exigé par le lanceur contrôlé.
# Ne pas réactiver WAL avant la qualification des moteurs embarqués.

# Impression commerciale : le mode par défaut reste une DEMO marquée non fiscale.
# Ne PAS activer pour des clients réels sans vérification de l'expert-comptable
# marocain et sans configuration des mentions de l'émetteur et du client.
GOCMD_REAL_INVOICES="0"
GOCMD_INVOICE_COMPLIANCE_APPROVED="0"
GOCMD_ISSUER_LEGAL_NAME=""
GOCMD_ISSUER_ADDRESS=""
GOCMD_ISSUER_ICE=""
GOCMD_ISSUER_IF=""
GOCMD_ISSUER_RC=""
